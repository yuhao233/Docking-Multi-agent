# ============================================================================
# 本地部署配置（复制为 .env 后填写；.env 已被 .gitignore 忽略）
#
# 提示：这些参数也可以在网页「设置」页面（http://127.0.0.1:PORT/#/settings）里改，
#       界面会显示每个字段生效值的来源，保存后立即生效（写入 config/local_settings.json）。
#       .env 适合做部署级默认值 / 脚本与 CI；界面设置优先于 .env 的全局项，
#       但 PORT / DOCKING_MAX_LIGANDS / UPLOAD_MAX_MB 三个部署保护项仍以 .env 为准。
#
# 完整变量清单、优先级与开发约定见 docs/architecture.md §7。
# ============================================================================

# ---------- LLM（必填：任意 OpenAI 兼容端点）----------
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=doubao-seed-2-0-pro-260215
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_TIMEOUT=600
# 最大输出 tokens（留空 = 交给端点默认）
# LLM_MAX_TOKENS=
# 豆包模型会发送 {"thinking":{"type":"disabled"}}；其他端点默认不发送。
# 如需强制关闭/开启思考：LLM_THINKING=disabled | enabled
LLM_THINKING=disabled
# 需要额外请求体字段时（JSON）：LLM_EXTRA_BODY={"foo":"bar"}
# 需要额外请求头时（JSON）：LLM_EXTRA_HEADERS={"X-Api-Key":"..."}

# ---------- 每个 Agent 用各自的模型（可选）----------
# 六个角色各自持有独立 LLM 实例，可分别指定模型与调用参数：
#   INTAKE(任务受理) / COORDINATOR(主管) / PROPERTY(属性评估) /
#   POCKET(口袋分析) / DOCKING(对接执行) / BINDING(结合模式)
# 写法：全局变量名 + _<角色大写>。
# 优先级：角色环境变量 > 界面设置(角色) > 内置角色默认 > 界面设置(全局) > .env > 内置默认。
# 未配置的角色继承上面的全局 LLM_* 设置。
# LLM_MODEL_DOCKING=deepseek-v4-pro
# LLM_MODEL_PROPERTY=deepseek-flash
# LLM_TEMPERATURE_PROPERTY=0
# LLM_TEMPERATURE_POCKET=0
# LLM_BASE_URL_BINDING=
# LLM_API_KEY_COORDINATOR=
# LLM_THINKING_DOCKING=disabled

# ---------- 任务受理层 ----------
# on(默认)=对话模式下用模型理解用户意图；off=只用确定性规则（测试/离线环境建议 off）
INTAKE_LLM=on
# InChIKey 反查：InChIKey 是单向哈希，离线只能认内置的常见化合物；
# on（默认）=未收录的键走 PubChem 在线反查（结果回算校验后写入本地缓存，之后离线可用）
INCHIKEY_ONLINE=on
# 单个 InChIKey 在线反查超时（秒）
#INCHIKEY_TIMEOUT=8

# ---------- 服务 ----------
PORT=5000
# 监听地址：默认只监听本机。服务没有鉴权，不要改成 0.0.0.0 暴露到不可信网络。
HOST=127.0.0.1
# 跨站写请求白名单（逗号分隔的完整 Origin，如 http://192.168.1.9:5000）。
# 服务无鉴权，因此**带 Origin 且与 Host 不同源**的写请求（POST/PUT/DELETE）一律 403；
# 只有经反向代理（浏览器看到公网 Origin、服务看到内网 Host）时才需要在这里声明。
# 缺 Origin 的请求（curl / 测试 / 同源导航）始终放行。
#DOCKING_ALLOWED_ORIGINS=
# 报告产物的下载地址前缀。留空则用 http://127.0.0.1:${PORT}
ARTIFACT_BASE_URL=
RUN_TIMEOUT_SECONDS=900
RECURSION_LIMIT=120
# 跑满步数时自动放宽的天花板（默认 = RECURSION_LIMIT 的 4 倍）；到顶后主管 Agent 用现有结果收尾
RECURSION_LIMIT_MAX=480
LOG_LEVEL=INFO
# ---------- 运行记录保留策略（var/runs 会随每次筛选增长）----------
# 启动时自动清理：1=按下面两个阈值清理旧运行；0/缺省=不自动清理（推荐先用脚本 dry-run）。
# 手动清理：.venv/bin/python scripts/prune_runs.py            # 只报告
#           .venv/bin/python scripts/prune_runs.py --apply    # 真正删除
RUNS_AUTO_PRUNE=0
# 至少保留最近 N 个运行（两条阈值**同时**满足才删：不属于最近 N 个，且超过 M 天）
RUNS_KEEP_LAST=200
# 只删除超过 M 天的运行；0=不限年龄（仅按数量保留）
RUNS_MAX_AGE_DAYS=30

# ---------- 对接（单机性能）----------
# 单次对接的分子数上限（0=不限制）。示例库较大时可设小值先冒烟测试。
DOCKING_MAX_LIGANDS=0
# 进程数**上限**覆盖（留空 = 自动规划：线程优先，每进程 8 线程，
# 进程数 = ceil(可用核/8)，再受分子数与内存夹紧；实测见 docs/architecture.md §8）
# DOCKING_WORKERS=
# 每个对接进程的线程数，默认 8（Vina 单分子线程扩展在 8 线程饱和，16/32 无额外收益）。
# 大库里有极个别超大柔性分子时调小它（=更多进程同时跑），可降低长尾阻塞面。
# DOCKING_THREADS_PER_WORKER=8
# 旧名，等价于 DOCKING_THREADS_PER_WORKER（保留兼容）
# DOCKING_SERIAL_THREADS=8
# 每个对接进程的内存预算（MB），用于按 MemAvailable 收敛进程数、防 OOM
# DOCKING_WORKER_MEM_MB=400
# Vina 单实例线程数（默认 1：进程级并行时不超订；只有单进程小库才建议调大）
# VINA_CPU=1

# ---------- 位姿与产物 ----------
# 位姿保存上限：超过则只保存每个受体最优的前 N 个（默认 5000）
# POSE_SAVE_MAX=5000
# 上述“最优的前 N 个”的 N（默认 200）
# POSE_TOP_N=200
# 位姿作为可下载产物的数量上限（默认 200）
# POSE_ARTIFACT_MAX=200

# ---------- 配体质子化态（运行级策略）----------
# ph（默认，按目标 pH 分配）/ neutralize（只中和带净电荷的分子）/ keep（保持输入形式，仅告警）
# LIGAND_PROTONATION=ph
# 目标 pH（仅 ph 策略生效；胃酸 1.5 / 溶酶体 4.5 / 生理 7.4）
# LIGAND_PROTONATION_PH=7.4
# 质子化引擎：auto（默认，装了专业引擎就用）/ dimorphite（强制专业引擎）/ rules（强制内置规则表）
# 专业引擎 = Dimorphite-DL（RDKit 的 pKa 规则库）。安装（**必须 --no-deps**：它的元数据把
# rdkit 钉在 <2026，而本项目需要 >=2026.3.6；实测 2.0.2 与 2026.3.6 兼容）：
#   uv pip install loguru && uv pip install --no-deps dimorphite-dl
# 未安装时自动回退内置规则表（近似，非 pKa 预测），并在报告与运行笔记里如实说明。
# LIGAND_PKA_ENGINE=auto
# pH 窗口半宽：目标 pH ± 该值内的微观态都参与选择（默认 0.5；0 = 只取该 pH）
# LIGAND_PKA_WINDOW=0.5
# pKa 精度因子：越小越少「临界态」（默认 0.1；调大→更多微观态候选）
# LIGAND_PKA_PRECISION=0.1

# ---------- 受体质子化（与配体同一目标 pH）----------
# pdb2pqr 可执行文件路径（留空 = 自动探测 PATH / ~/pymol/bin/pdb2pqr）。
# 受体按目标 pH 重新分配 His/Asp/Glu/Lys/Cys/Tyr 的质子化态；找不到时回退模板默认态并如实标注。
# PDB2PQR_BIN=
# pdb2pqr 超时秒数（默认 900）
# PDB2PQR_TIMEOUT=900

# ---------- 推荐化合物排行 ----------
# 报告「推荐化合物排行」与 2D 结构图/性质空间图展示的条数（默认 10）
# RECOMMEND_TOP_N=10
# 综合分权重：对接亲和力 / 配体效率 LE / 类药性(Lipinski) / 理化性质窗口(logP,TPSA)
# RANK_WEIGHTS=0.45,0.20,0.20,0.15

# ---------- Agent 上下文与两阶段漏斗 ----------
# 工具回传给模型的明细行数上限（只影响“模型看到的视图”，不是输入上限）
# AGENT_TOOL_TOP_N=20
# 触发两阶段漏斗的候选数阈值（默认 500）
# AGENT_FUNNEL_MIN=500
# 精算阶段的头部数量（默认 200）
# AGENT_REFINE_TOP_N=200
# 粗筛 / 精算的 search exhaustiveness（默认 1 / 16）
# AGENT_COARSE_EXHAUSTIVENESS=1
# AGENT_FINE_EXHAUSTIVENESS=16
# 分片调度护栏：片数不得超过该值（默认 8）
# AGENT_SHARD_MAX=8
# ---- Agent 中间件（P1：治理逻辑统一由 LangChain 官方中间件承担）----
# 模型调用重试次数（429/5xx/网络抖动；0=关闭重试中间件，默认 2）
# AGENT_RETRY_MAX=2
# 安全网级限额：单次运行的模型调用 / 工具调用上限（0=不限制；默认 200 / 400）
# 阈值取得很高，正常筛选与长对话都碰不到；命中时**优雅结束**（exit_behavior=end），
# 已经算出来的对接结果不会因为触发安全网而丢掉
# AGENT_MODEL_CALL_LIMIT=200
# AGENT_TOOL_CALL_LIMIT=400
# 子 Agent 结构化输出（response_format=ToolStrategy）：auto=能用就用、被供应商拒绝时自动降级为
# 文本 JSON 契约（默认，兼容 DeepSeek thinking mode —— 它不支持强制 tool_choice）；
# on=不降级（被拒绝就报错）；off=完全不用结构化输出
# AGENT_STRUCTURED_OUTPUT=auto
# 长对话摘要：超过 AGENT_SUMMARY_TRIGGER_MESSAGES 条时把旧消息摘要成一条（默认 on）
# 触发阈值必须大于保留条数，否则会自动纠正为 保留+2
# AGENT_SUMMARY_ENABLED=on
# AGENT_SUMMARY_TRIGGER_MESSAGES=30
# AGENT_SUMMARY_KEEP_MESSAGES=20

# ---------- 对接参数自动规划（core/params.py；运行级/阶段级，绝不逐分子）----------
# 总开关：on=按任务类型/库柔性/盒体积自动规划 exhaustiveness、n_poses 与两阶段漏斗
# AUTO_PARAM_ENABLED=on
# pilot 预算护栏：先用最贵的少数分子以 exhaustiveness=1 真实试跑，外推总耗时后按精度优先降级
# （只测量、不写位姿、不进排序；失败自动退回静态规划）
# AUTO_PARAM_PILOT=on
# pilot 试跑分子数 / 触发 pilot 的最小库规模（默认 3 / 50）
# AUTO_PARAM_PILOT_N=3
# AUTO_PARAM_PILOT_MIN=50
# 预算 = 该比例 × RUN_TIMEOUT_SECONDS（默认 0.6 × 900 = 540 s）
# AUTO_PARAM_BUDGET_RATIO=0.6
# 搜索强度夹取区间与任务基准值（默认 2–32；screening=12 / binding=16）
# AUTO_PARAM_EXH_MIN=2
# AUTO_PARAM_EXH_MAX=32
# AUTO_PARAM_BASE_SCREENING=12
# AUTO_PARAM_BASE_BINDING=16
# 库柔性统计：按重原子数取前 N 个算可旋转键；f_rot=clamp(P90/基准, 下限, 上限)
# AUTO_PARAM_STATS_SAMPLE=500
# AUTO_PARAM_FLEX_DIVISOR=5
# AUTO_PARAM_FLEX_MIN=0.75
# AUTO_PARAM_FLEX_MAX=2.5
# 盒体积系数：f_box=clamp((V/参考边长³)^(1/3), 1.0, 上限)
# AUTO_PARAM_BOX_REF=22
# AUTO_PARAM_BOX_FACTOR_MAX=2.0
# 超预算降级：先降精算头部到下限，再降强度（不低于基准的一半）
# AUTO_PARAM_REFINE_TOP_MIN=100
# AUTO_PARAM_REFINE_TOP_LARGE=300
# AUTO_PARAM_LARGE_LIB=5000
# 姿态/结合模式分析的 n_poses 与其上限（默认 3 / 5）
# AUTO_PARAM_N_POSES_BINDING=3
# AUTO_PARAM_N_POSES_MAX=5

# ---------- 结合口袋 ----------
# 保存/展示的预测口袋数量（默认 10）
# POCKET_TOP_N=10
# 口袋引擎：auto(默认) / p2rank / geometric / known_site
# POCKET_ENGINE=auto
# 盒子余量与边长范围（Å）：默认 4 / 18 / 30
# POCKET_PADDING=4
# POCKET_MIN_SIZE=18
# POCKET_MAX_SIZE=30
# ---- 库级配体感知下限 + 超限分子分组（C 方案；详见 docs/architecture.md §15.7b）----
# 用整库配体 3D 跨度的 P95 + 10 Å 抬高盒子下限（on/off，默认 on；off = 旧行为）
# BOX_SPAN_ENABLED=on
# 抽样分子数 K：按重原子数降序取前 K 个生成 3D（20–1000，默认 200；库小于 K 时全算）
# BOX_SPAN_SAMPLE=200
# 超限判据余量（Å）：某分子「跨度 + 该值 > 主盒对应边」→ 划入 large 组（默认 10）
# BOX_GROUP_MARGIN=10
# 大配体组盒子余量（Å）：组内最大跨度 + 该值，中心与主组完全相同（默认 12）
# BOX_LARGE_PADDING=12
# ---- 外部工具（自行安装；也可在设置页「外部工具」里填写，界面值与 .env 优先级见设置页）----
# 对接 CLI（仅登记，不改变对接由谁执行）：本机命令行版 AutoDock Vina 的路径。
# 设置页「检测」与 scripts/doctor.sh 会显示它的类型与版本；留空则自动查找 PATH 上的 vina。
# VINA_BIN=/path/to/vina
# 经典 AutoDock4 CPU 引擎（engine=autodock 或 auto 回退时使用；也供 AutoDock-GPU 建格点图）。
# 留空则查找 PATH 上的同名可执行文件；两件套缺一不可。
# AUTODOCK4_BIN=/path/to/autodock4
# AUTOGRID4_BIN=/path/to/autogrid4
# 对接引擎（**改用它执行对接**）：Vina 兼容的可执行文件 —— 识别 Uni-Dock / Vina-GPU /
# AutoDock-GPU 三类，以及 CPU 版 AutoDock Vina CLI。留空 = 用内置 CPU Vina（同版本、
# 支持每分子盒子/分批/取消，推荐）；填了但探测不通过 = 运行直接失败并提示（不会静默改用 CPU）。
# 目前**已接入执行适配**的是 AutoDock-GPU 与 CPU 版 Vina CLI；Uni-Dock / Vina-GPU 只登记。
# EXTERNAL_DOCKING_BIN=
# GPU 设备序号（多卡机器指定用哪块卡）
# GPU_DEVICE=0
# 单批提交给 GPU 引擎的配体数（显存不足时调小）
# GPU_BATCH_SIZE=100

# 本地 P2Rank 目录（留空 = 自动找 assets/tools/p2rank* 或 PATH 上的 prank）
# P2RANK_HOME=
# P2Rank 线程数（留空 = cpu//2）
# P2RANK_THREADS=

# ---------- 报告与流式输出 ----------
# 报告内嵌表格行数上限（默认 50）
# REPORT_TOP_N=50
# 图表分子数上限 / 柱状图最大条数（默认 20 / 50）
# CHART_TOP_N=20
# CHART_BAR_MAX=50
# GET /api/runs/{id} 内联的明细行数上限（默认 200，其余走分页接口/产物下载）
# RESULT_INLINE_LIMIT=200
# SSE 单条工具结果回传的字符上限（默认 2000）
# STREAM_TOOL_RESULT_CHARS=2000
# SSE 节流：批量条数 / 刷新间隔(ms) / 进度最小间隔(ms)
# SSE_BATCH_SIZE=25
# SSE_FLUSH_MS=200
# SSE_PROGRESS_MS=1000

# ---------- 检查点 ----------
# memory(默认，进程内) | sqlite(需额外安装 langgraph-checkpoint-sqlite)
CHECKPOINT_BACKEND=memory

# 产物下载 URL 使用的主机名（默认 127.0.0.1；容器/远程访问时可改）
# ARTIFACT_HOST=127.0.0.1
# uvicorn 自身日志级别（默认 info）
# UVICORN_LOG_LEVEL=info
# 工作区根目录（默认 = 项目根；容器部署可指向挂载盘）
# DOCKING_WORKSPACE=
# 设置文件位置覆盖（多实例/测试用；默认 config/local_settings.json）
# LOCAL_SETTINGS_PATH=

# 兼容遗留：老代码/第三方片段读取的工作区变量（ensure_runtime_env 会自动设置）
# COZE_WORKSPACE_PATH=
# 兼容遗留：旧版运行端口变量（现在用 PORT）
# DEPLOY_RUN_PORT=

# 上传文件大小上限（MB）
UPLOAD_MAX_MB=200
